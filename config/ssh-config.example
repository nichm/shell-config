# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# =============================================================================
# LOCAL SERVER CONFIG (gitignored — add your servers in ssh-config.local)
# =============================================================================
# IMPORTANT: Include directives MUST be before any Host blocks to apply globally.
# Create config/ssh-config.local with your Host blocks.
# See config/personal.env.example for setup instructions.
# Example:
#   Host my-vps
#       HostName your-vps-ip
#       User root
#       IdentityFile ~/.ssh/id_ed25519
#       IdentitiesOnly yes
# =============================================================================
Include ~/.shell-config/config/ssh-config.local

# =============================================================================
# SSH Client Configuration
# =============================================================================
# Choose ONE of the two auth modes below. Remove or comment out the other.
#
# MODE A — 1Password SSH Agent (recommended if you use 1Password)
#   1Password manages keys via its GUI. The IdentityAgent line routes SSH
#   through 1Password's socket. No terminal passphrase prompts.
#
# MODE B — macOS Keychain (recommended otherwise)
#   Keys stored in macOS Keychain. UseKeychain yes + AddKeysToAgent yes
#   ensures silent auto-load. The init.sh SSH loader runs
#   `ssh-add --apple-load-keychain` on shell startup so the agent is
#   never empty — prevents passphrase prompts in TUI tools (Claude Code, etc.)
#
# Either way: run `ssh-add --apple-use-keychain ~/.ssh/id_ed25519` once
# to store your passphrase in the Keychain.
# =============================================================================

# --- MODE A: 1Password SSH Agent ---
# Uncomment IdentityAgent line to activate. Comment it out for Mode B.
Host *
    # IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    Compression yes
    GSSAPIAuthentication no

# GitHub — HTTPS via gh CLI is preferred; SSH kept for compatibility
# For HTTPS auth, configure gitconfig.local with the gh credential helper:
#   [credential "https://github.com"]
#       helper =
#       helper = !/opt/homebrew/bin/gh auth git-credential
Host github.com
    HostName github.com
    User git
